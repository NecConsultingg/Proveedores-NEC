# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys → Publishable key). Sin estas variables el sitio usa datos de ejemplo.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Dirección pública del sitio (opcional; en Vercel se toma sola)
# NEXT_PUBLIC_SITE_URL=https://proveedoresnec.com
